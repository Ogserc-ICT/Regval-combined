# Copy to .env.local for development. Never commit real values.

# Pooled connection for app traffic; direct (unpooled) connection for migrations.
DATABASE_URL=postgres://ogserc:ogserc@localhost:5433/ogserc
DATABASE_URL_UNPOOLED=postgres://ogserc:ogserc@localhost:5433/ogserc
# Integration tests (wiped and migrated on every run).
TEST_DATABASE_URL=postgres://ogserc:ogserc@localhost:5433/ogserc_test

# 32+ random characters: openssl rand -base64 32
AUTH_SECRET=change-me-to-a-long-random-string
# Public URL of the app (Vercel sets VERCEL_URL; set this for production).
BETTER_AUTH_URL=http://localhost:3000

# Protects /api/cron/* (Phase 4).
CRON_SECRET=change-me

# Email (Phase 4): console | resend
EMAIL_PROVIDER=console
EMAIL_FROM=registry@ogserc.org.ng
RESEND_API_KEY=

# First admin account, created by `pnpm db:seed` if no admin exists.
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_EMAIL=
# Leave blank to have the seed print a one-time password.
BOOTSTRAP_ADMIN_PASSWORD=

# Test-only "today" override (YYYY-MM-DD). Ignored in production.
APP_TODAY=

# Seed EXAMPLE rows (development and preview only; refused in production).
SEED_EXAMPLES=true
